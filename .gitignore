/android/app/release

# Firebase / Google services (injected in CI from secrets; generate locally with flutterfire configure)
.firebaserc
android/app/google-services.json
**/GoogleService-Info.plist
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Firebase rules (can contain security policy; inject in CI or deploy from Console)
# Firebase local config (optional; firebase.json is tracked)
# firestore.rules and firestore.indexes.json are tracked for deploy
storage.rules
*.json
# Android release signing (injected in CI from secrets; use key.properties + keystore locally)
android/key.properties
android/app/release.keystore
